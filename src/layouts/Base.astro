---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReaderData from '../components/ReaderData.astro';
import { site } from '../site.config';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  articleCss?: string; // 記事専用CSS（レイヤー外で読み込む）
  progress?: boolean; // 記事ページの読了バー
  current?: string;
}

const {
  title,
  description = site.description,
  ogImage = site.ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  articleCss = '',
  progress = false,
  current = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title === site.name ? title : `${title}｜${site.name}`;
const ogAbs = new URL(ogImage, site.url).href;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbs} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${site.x.handle}`} />
    <link rel="icon" href="/brand/icon-512.png" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/icon-512.png" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/feed/" />
    <meta name="theme-color" content="#f3eee3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16140f" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    />
    <!-- テーマ：保存された設定 > OSの設定。描画前に決めてちらつきを防ぐ -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    {articleCss && <style set:html={articleCss} />}
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    {
      site.ga4Id && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`} />
          <script is:inline define:vars={{ id: site.ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', id);
          </script>
        </>
      )
    }
    {
      site.adsense.client && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsense.client}`}
          crossorigin="anonymous"
        />
      )
    }
    <!-- 逆アクセスランキング（Blozoo）解析用 -->
    <script is:inline define:vars={{ u: site.blozoo.u, t: site.blozoo.t }}>
      window.blzPa = 'rank'; window.blzUa = u; window.blzTa = t;
    </script>
    <script is:inline src="https://js.blozoo.info/js/ranktool/analyze.js"></script>
  </head>
  <body>
    <Header current={current} progress={progress} />
    <slot />
    <Footer />
    <ReaderData />
    <script>
      import '../scripts/reader.ts';
    </script>
  </body>
</html>
