---
// 手動の広告ユニット。高さを先に確保してから読み込む（CLS対策）。
// site.config.ts で client とスロットIDが未設定のあいだは、枠だけ表示する。
import { site } from '../site.config';
type Kind = keyof typeof site.adsense.slots;
interface Props { kind: Kind; height?: number; pcOnly?: boolean; sticky?: boolean }
const { kind, height = 250, pcOnly = false, sticky = false } = Astro.props;
const slot = site.adsense.slots[kind];
const live = Boolean(site.adsense.client && slot);
// 管理画面のフォーマットに合わせる：記事内広告は fluid、Multiplex は autorelaxed、サイドバーは固定サイズのディスプレイ
const inArticle = kind === 'inArticle' || kind === 'listing';
const fixed = ({ sidebarTop: [300, 250], sidebar: [300, 600] } as Partial<Record<Kind, [number, number]>>)[kind];
const format = kind === 'multiplex' ? 'autorelaxed' : inArticle ? 'fluid' : undefined;
---
<aside
  class:list={['ad', pcOnly && 'ad--pc-only', sticky && 'ad--sidebar']}
  style={`--ad-h:${height}px`}
  aria-label="広告"
  data-filled={live ? '' : undefined}
>
  <span class="ad__label">広告</span>
  {
    live && (
      <>
        <ins
          class="adsbygoogle"
          style={fixed ? `display:block;width:${fixed[0]}px;height:${fixed[1]}px;margin:0 auto` : 'display:block'}
          data-ad-client={site.adsense.client}
          data-ad-slot={slot}
          data-ad-format={format}
          data-ad-layout={inArticle ? 'in-article' : undefined}
        />
        <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
      </>
    )
  }
</aside>
