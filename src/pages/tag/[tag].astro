---
import ListPage from '../../components/ListPage.astro';
import { getPublished, tagKey } from '../../lib/articles';

export async function getStaticPaths() {
  const all = await getPublished();
  const byKey = new Map<string, { tag: string; articles: typeof all }>();
  for (const a of all) for (const tag of a.data.tags) {
    const k = tagKey(tag);
    if (!byKey.has(k)) byKey.set(k, { tag, articles: [] });
    const e = byKey.get(k)!;
    if (!e.articles.includes(a)) e.articles.push(a);
  }
  return [...byKey].map(([k, v]) => ({ params: { tag: k }, props: v }));
}
const { tag, articles } = Astro.props;
---
<ListPage title={`#${tag}`} lead={`「${tag}」に関する記事の一覧です。`} articles={articles} noindex={articles.length < 2} />
