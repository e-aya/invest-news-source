---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AdSlot from '../components/AdSlot.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Sidebar from '../components/Sidebar.astro';
import {
  getPublished, readBody, readStyle, readingMinutes, fmtDate, categoryLabel,
  seriesArticles, related, tickerUrl, tagUrl, articleUrl, coverOf, logoOf, type Article,
} from '../lib/articles';
import { site } from '../site.config';

export async function getStaticPaths() {
  const all = await getPublished();
  return all.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const d = article.data;
const all = await getPublished();
const seriesList = await getCollection('series');
const series = d.series ? seriesList.find((s) => s.id === d.series) : undefined;
const inSeries = series ? seriesArticles(all, series.id) : [];
const pos = inSeries.findIndex((a) => a.id === article.id);
const prev = pos > 0 ? inSeries[pos - 1] : undefined;
const next = pos >= 0 && pos < inSeries.length - 1 ? inSeries[pos + 1] : undefined;
const rel = related(all, article, 3);

let body = readBody(article.id);
const css = readStyle(article.id);
const minutes = readingMinutes(body);
const updated = d.updatedAt && d.updatedAt > d.publishedAt ? d.updatedAt : undefined;
const legacy = d.format === 'legacy';
// 旧記事の本文に独自の大見出し（h1）がある場合だけ、ページ側のタイトルを出さない
const ownTitle = legacy && /<h1[\s>]/i.test(body);

// 新テンプレートの記事だけ、第2セクションの後に記事内広告を差し込む。
// 旧記事は記事CSSの全称リセットが広告枠に効いてしまうため、本文の後に置く。
let bodyHead = body;
let bodyTail = '';
if (!legacy) {
  const re = /<\/section>/g;
  let m: RegExpExecArray | null;
  let n = 0;
  while ((m = re.exec(body))) {
    if (++n === 2) {
      bodyHead = body.slice(0, m.index + m[0].length);
      bodyTail = body.slice(m.index + m[0].length);
      break;
    }
  }
}

const url = new URL(articleUrl(article), site.url).href;
// 冒頭の画像：アイキャッチ（public/covers/<スラッグ>.*）→ なければ銘柄のロゴ → どちらもなければ出さない。
// 本文に独自の大見出しを持つ旧記事は本文側にヒーローがあるので、ロゴは出さない
const cover = coverOf(article.id);
const logoTicker = cover || ownTitle ? undefined : d.tickers.map((t) => ({ ...t, logo: logoOf(t.code) })).find((t) => t.logo);
const ogImage = d.ogImage ?? cover?.src ?? site.ogImage;
const crumbs = [
  { name: 'ホーム', url: '/' },
  series ? { name: series.data.name, url: `/series/${series.id}/` } : { name: categoryLabel(d.category), url: `/category/${d.category}/` },
  { name: d.title, url: articleUrl(article) },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.points.length ? d.points.join(' ') : d.description,
    image: [new URL(ogImage, site.url).href],
    datePublished: d.publishedAt.toISOString(),
    dateModified: (updated ?? d.publishedAt).toISOString(),
    mainEntityOfPage: url,
    inLanguage: 'ja',
    author: {
      '@type': 'Person',
      name: site.author.name,
      jobTitle: site.author.title,
      url: new URL(site.author.profileUrl, site.url).href,
      sameAs: [site.x.url],
    },
    publisher: {
      '@type': 'Organization',
      name: site.name,
      logo: { '@type': 'ImageObject', url: new URL('/brand/icon-512.png', site.url).href },
    },
    keywords: d.tags.join(','),
    about: d.tickers.map((t) => ({ '@type': 'Corporation', name: t.name, tickerSymbol: t.code })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.url, site.url).href })),
  },
];
---
<Base
  title={d.title}
  description={d.description}
  ogImage={ogImage}
  ogType="article"
  jsonLd={jsonLd}
  articleCss={css}
  progress
>
  <div class="wrap page with-aside">
    <article class="main post">
      <nav class="crumbs" aria-label="パンくず">
        {crumbs.slice(0, -1).map((c) => <><a href={c.url}>{c.name}</a> › </>)}<span>{d.title}</span>
      </nav>

      <div class="post__pills">
        {series && <a class="pill is-solid" href={`/series/${series.id}/`} style="text-decoration:none">{series.data.name}{pos >= 0 && ` ${pos + 1}/${inSeries.length}`}</a>}
        <a class="pill is-ac" href={`/category/${d.category}/`} style="text-decoration:none">{categoryLabel(d.category)}</a>
        {d.tickers.map((t) => (
          <a class="pill is-outline" href={tickerUrl(t.code)}><span class="num">{t.code}</span> {t.name} の記事一覧</a>
        ))}
      </div>

      {cover && (
        <figure class="post__cover">
          <img src={cover.src} alt={d.title} width={cover.width} height={cover.height} fetchpriority="high" decoding="async" />
        </figure>
      )}
      {logoTicker && (
        <a class="post__logo" href={tickerUrl(logoTicker.code)} aria-label={`${logoTicker.name}（${logoTicker.code}）の記事一覧`}>
          <span class="post__logo-img"><img src={logoTicker.logo} alt={`${logoTicker.name}のロゴ`} /></span>
          <span class="post__logo-name"><span class="num">{logoTicker.code}</span> {logoTicker.name}</span>
        </a>
      )}

      {!ownTitle && <h1 class="post__title">{d.title}</h1>}

      <div class="byline">
        <a class="byline__who" href="#author">
          <img src={site.author.icon} alt="" width="36" height="36" />
          <span><strong>{site.author.name}</strong><small>{site.author.title}</small></span>
        </a>
        <span>公開 <time datetime={d.publishedAt.toISOString()}>{fmtDate(d.publishedAt)}</time></span>
        {updated && <span class="date is-updated">更新 <time datetime={updated.toISOString()}>{fmtDate(updated)}</time></span>}
        <span>読了目安 {minutes}分</span>
      </div>

      <div class="actions">
        <button class="btn" type="button" data-save={article.id} aria-pressed="false">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"></path></svg>
          <span data-label>あとで読む</span>
        </button>
        {d.tickers.slice(0, 1).map((t) => (
          <button class="btn" type="button" data-watch={t.code.toUpperCase()} aria-pressed="false">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            <span data-label>{t.code} をウォッチ</span>
          </button>
        ))}
        <a class="btn" href={`https://x.com/intent/post?text=${encodeURIComponent(d.title)}&url=${encodeURIComponent(url)}&via=${site.x.handle}`} target="_blank" rel="noopener">
          Xでシェア
        </a>
      </div>

      {
        !legacy && d.points.length > 0 && (
          <section class="points">
            <h2>この記事のポイント</h2>
            <ul>{d.points.map((p) => <li>{p}</li>)}</ul>
          </section>
        )
      }

      <div class:list={['post__body', legacy && !css.trim() && 'is-bare']} data-article-body data-pagefind-body>
        <Fragment set:html={bodyHead} />
        {!legacy && bodyTail && <AdSlot kind="inArticle" height={280} />}
        {!legacy && <Fragment set:html={bodyTail} />}
      </div>
      {
        legacy && (
          /*
            旧記事の多くは「白い紙面に黒い文字」を前提に、背景を透明のまま文字色だけ暗く指定している。
            そういう記事はダーク表示だと読めないので、ここで判定して印を付け、ダーク表示のときだけ明るい紙面に載せる。
            描画前に決めてちらつきを防ぐため、本文の直後で同期的に実行する。
          */
          <script is:inline>
            (function () {
              var body = document.querySelector('[data-article-body]');
              if (!body) return;
              function rgb(c) { var m = c.match(/[\d.]+/g) || []; return m.map(Number); }
              function lum(c) {
                var f = function (v) { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };
                return 0.2126 * f(c[0]) + 0.7152 * f(c[1]) + 0.0722 * f(c[2]);
              }
              // 記事側で背景色を塗っていない（ページの背景が透けて見える）要素か
              function onPage(el) {
                for (var e = el; e && e !== body.parentElement; e = e.parentElement) {
                  var cs = getComputedStyle(e), c = rgb(cs.backgroundColor);
                  if (cs.backgroundImage !== 'none' || (c.length >= 3 && (c.length < 4 || c[3] > 0.5))) return false;
                }
                return true;
              }
              var dark = 0, total = 0;
              var w = document.createTreeWalker(body, NodeFilter.SHOW_TEXT);
              while (w.nextNode()) {
                var n = w.currentNode.textContent.replace(/\s+/g, '').length;
                var el = w.currentNode.parentElement;
                if (!n || el.closest('svg')) continue;
                total += n;
                if (lum(rgb(getComputedStyle(el).color)) < 0.18 && onPage(el)) dark += n;
              }
              if (total && dark / total >= 0.03) body.classList.add('is-paper');
            })();
          </script>
        )
      }
      <!-- 本文の最後まで読んだら既読にする（シリーズの「次の記事」より上に置く） -->
      <div data-read-mark={article.id} aria-hidden="true" style="height:1px"></div>

      {legacy && <AdSlot kind="inArticle" height={280} />}

      {
        series && (prev || next) && (
          <nav class="series-nav" aria-label="シリーズ内の前後の記事">
            {prev ? (
              <a href={articleUrl(prev)}><small>← 前の記事（{series.data.name}）</small><strong>{prev.data.title}</strong></a>
            ) : <span />}
            {next ? (
              <a href={articleUrl(next)} style="text-align:right"><small>次の記事（{series.data.name}）→</small><strong>{next.data.title}</strong></a>
            ) : <span />}
          </nav>
        )
      }
      {series && <a class="btn is-primary is-block" href={`/series/${series.id}/`}>{series.data.name}を全部読む</a>}

      <AdSlot kind="multiplex" height={300} />

      {
        rel.length > 0 && (
          <section>
            <h2 style="font-size:20px;margin-bottom:14px">関連記事</h2>
            <div class="card-grid">{rel.map((a) => <ArticleCard article={a} />)}</div>
          </section>
        )
      }

      {
        d.tags.length > 0 && (
          <div class="chip-row" aria-label="タグ">
            {d.tags.map((t) => <a class="chip" href={tagUrl(t)}>#{t}</a>)}
          </div>
        )
      }

      <AuthorBox />

      <p class="disclaimer">
        本記事は情報提供を目的としたもので、特定銘柄の売買を推奨するものではありません。投資判断はご自身の責任でお願いします。
      </p>
    </article>

    <aside class="aside">
      <Sidebar showAbout={false} />
    </aside>
  </div>
</Base>

<style>
  .post > :global(* + *) { margin-top: 24px; }
  .post__pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .post__cover { margin-inline: 0; }
  .post__cover img { display: block; width: 100%; height: auto; border-radius: 14px; }
  .post__logo {
    display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 20px 16px 14px;
    background: var(--acs); border-radius: 14px; color: var(--ink); text-decoration: none;
  }
  /* 枠の大きさは固定し、ロゴの縦横比にかかわらず枠の中に収める */
  .post__logo-img {
    display: flex; align-items: center; justify-content: center;
    width: min(70%, 320px); height: clamp(84px, 14vw, 120px); padding: 12px 20px; background: #fff; border-radius: 12px;
  }
  .post__logo-img img { width: 100%; height: 100%; object-fit: contain; }
  .post__logo-name { font-size: 14px; color: var(--mu); }
  .post__title { font-size: clamp(25px, 1.8vw + 16px, 34px); line-height: 1.45; }
  .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; font-size: 14px; color: var(--mu); }
  .byline__who { display: flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; }
  .byline__who img { width: 36px; height: 36px; border-radius: 50%; }
  .byline__who span { display: flex; flex-direction: column; line-height: 1.4; }
  .byline__who small { font-size: 12px; color: var(--mu); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .points { background: var(--acs); border-radius: 16px; padding: 20px 24px; }
  .points h2 { font-size: 16px; color: var(--ac); margin-bottom: 6px; }
  .points ul { padding-left: 1.2em; line-height: 1.9; }
  .post__body { font-size: clamp(16px, 0.3vw + 15px, 17px); line-height: 1.9; }
  /* 新テンプレート記事の本文。旧記事は記事CSS側で整形済みなので触らない */
  .post__body :global(> section + section) { margin-top: 36px; }
  .post__body :global(> section h2) { font-size: clamp(20px, 1vw + 15px, 24px); line-height: 1.5; margin-bottom: 14px; }
  .post__body :global(> section p + p) { margin-top: 14px; }
  .post__body :global(figure) { margin: 24px 0 0; }
  .post__body :global(figcaption) { margin-top: 8px; font-size: 13px; color: var(--mu); }
  .post__body > :global(aside.ad) { margin-block: 36px; }
  /* 専用CSSのない旧記事向けの最低限の体裁（専用CSSがある記事ではそちらが優先される） */
  .post__body.is-bare :global(table) { width: 100%; border-collapse: collapse; margin-block: 16px; font-size: 15px; display: block; overflow-x: auto; }
  .post__body.is-bare :global(th), .post__body.is-bare :global(td) { border: 1px solid var(--ln); padding: 8px 10px; text-align: left; }
  .post__body.is-bare :global(th) { background: var(--sf2); }
  .post__body.is-bare :global(h2) { margin-top: 32px; }
  .post__body.is-bare :global(h3) { margin-top: 24px; }
  .post__body.is-bare :global(p + p) { margin-top: 12px; }
  /* 白い紙面前提の旧記事（判定は本文直後のスクリプト）。ダーク表示のときだけライトと同じ紙面に載せる */
  :global(:root[data-theme='dark']) .post__body.is-paper {
    --bg: #f3eee3; --sf: #fbf8f1; --sf2: #ece5d6; --ink: #1c1a16; --mu: #5a5348; --ln: #d8cfbe;
    --ac: #2f7a2c; --acs: #e3edd5; --or: #a84f0b; --ors: #f6e4d2;
    color-scheme: light; background: var(--sf); color: var(--ink);
    padding: clamp(16px, 3vw, 28px); border-radius: var(--radius);
  }
  .series-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .series-nav a {
    display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border: 1px solid var(--ln);
    border-radius: 14px; background: var(--sf); color: var(--ink); text-decoration: none;
  }
  .series-nav small { color: var(--mu); font-size: 12px; }
  .series-nav strong { font-size: 15px; }
  @media (max-width: 560px) { .series-nav { grid-template-columns: 1fr; } }
  .disclaimer { padding: 16px 18px; border: 1px solid var(--ln); border-radius: 12px; font-size: 13px; color: var(--mu); }
</style>
